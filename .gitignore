# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/.coverage
**/coverage-*.json

# next.js
/.next/
/out/
dist/
bin/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# package manager
package-lock.json
yarn.lock
pnpm-lock.yaml

# semantic-release
.nyc_output

# env files (can opt-in for committing if needed)
.env*
!.env.example
secrets/
firmware/secrets/
firmware/usage-monitor/main/secrets.h
firmware/usage-monitor/build/
firmware/usage-monitor/managed_components/
firmware/usage-monitor/dependencies.lock
firmware/usage-monitor/sdkconfig
firmware/usage-monitor/sdkconfig.old
usage-api/data/
usage-api/cloudflared/*.json
usage-api/cloudflared/*.pem

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# flutter
.dart_tool
build
GoogleService-Info.plist

repomix-output.xml
.serena/cache
screenshots/*
docs/screenshots/*
logs.txt
test-ck
__pycache__

# CK meta commands
prompt.md
ck.md

# Local-only state inside tracked claude source
.claude/agent-memory/
.claude/hooks/.logs/
.claude/session-state/
.claude/settings.bak.json
.claude/skills/.venv/
.claude/skills/ai-multimodal/assets/demo-*
.claude/session-state/*.tmp

# Gemini CLI settings (symlink to staged .claude/.mcp.json)
.gemini/settings.json
# Showoff/marketing assets (images, showcases)
assets/
# Exception: use-mcp ships a persistent tool catalog at assets/tools.json
!claude/skills/use-mcp/assets/
!claude/skills/use-mcp/assets/**

# External repos for study/reference
external/

# Git worktrees (local development only)
worktrees/
# Gemini CLI settings (contains user-specific config)
.gemini/
