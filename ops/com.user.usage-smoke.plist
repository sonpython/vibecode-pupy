<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.usage-smoke</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_DIR__/ops/daily_smoke_test.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>USAGE_STATUS_URL</key>
    <string>http://127.0.0.1:8080/status</string>
    <key>DEVICE_SECRET</key>
    <string>replace-with-device-secret</string>
    <key>ALERT_WEBHOOK</key>
    <string></string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/usage-smoke.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/usage-smoke.log</string>
</dict>
</plist>
